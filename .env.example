# Copy to .env.local for local development, or set these in Vercel > Settings > Environment Variables.

# WhatsApp number used by every CTA and in structured data (08... or 62... format).
# Falls back to the number in src/config/site.ts when empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Search engine ownership tokens (content attribute only, not the whole meta tag).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Set to 1 on any non-Vercel staging host so it is served with noindex and a blocking robots.txt.
# On Vercel this is automatic: only VERCEL_ENV=production is indexable.
SITE_NOINDEX=
